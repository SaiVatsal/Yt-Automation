# ShortsForge Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key for Claude (required for clip analysis and narration)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# YouTube Data API v3 OAuth2 Client Secrets
# Get yours at: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID for Desktop Application
# Then download the client_secret_*.json and place it in data/client_secrets.json
# Or set these environment variables:
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# Optional: Google Cloud Project ID (for quota tracking)
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here

# Voicebox TTS (local REST API)
# If using Voicebox, ensure it's running at the base_url in config.yaml
# No API key needed for local Voicebox

# Optional: Override config.yaml values
# WHISPER_MODEL=small
# LLM_MODEL=claude-sonnet-5-5
# SPEECH_DENSITY_THRESHOLD=0.35
# CLIP_MIN_LEN=9
# CLIP_MAX_LEN=60
# TOP_N=5
# TTS_PROVIDER=voicebox
# TTS_VOICEBOX_BASE_URL=http://127.0.0.1:17493
# TTS_VOICEBOX_PROFILE_ID=default_profile
# TTS_EDGE_TTS_VOICE=en-US-JennyNeural